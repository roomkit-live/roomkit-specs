{
  "$schema": "../../scenario.schema.json",
  "id": "greeting/a-voice-session-s-greeting-holds-the-agents-until-it-is-said",
  "title": "An agent with a greeting and auto_greet greets a voice session behind a gate: a message that comes while the greeting's playback holds reaches the agent's model only once the greeting was said",
  "rules": [
    "§19.1"
  ],
  "requirements": [
    "RK-19.1-041"
  ],
  "requires_features": [
    "voice"
  ],
  "notes": "The AFTER_TTS hook's gate is reached once the greeting's playback ended, and holds the greeting's saying until a step opens it; the agent's generation, held at its own gate, is reached strictly after. The voice channel, a transport of the room, also speaks the person's message.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "greeter",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Answer.",
              "gate": "answering"
            }
          ]
        },
        "agent": {
          "greeting": "Welcome.",
          "auto_greet": true
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "greeter"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "said",
        "trigger": "after_tts",
        "execution": "async",
        "reactions": [
          {
            "gate": "said"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "room_id": "r1",
      "channel_id": "voice",
      "participants": [
        "alice"
      ],
      "playback_gate": "playing"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550101",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      },
      "background": true,
      "as": "msg"
    },
    {
      "open": "playing"
    },
    {
      "wait_for": "said"
    },
    {
      "open": "said"
    },
    {
      "wait_for": "answering",
      "after": "said"
    },
    {
      "open": "answering"
    },
    {
      "await": "msg"
    },
    {
      "idle": true
    },
    {
      "call": "voice.read",
      "channel_id": "voice",
      "expect": {
        "result": {
          "synthesized": [
            "Welcome.",
            "Hi",
            "Answer."
          ]
        }
      }
    }
  ]
}
