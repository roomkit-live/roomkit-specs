{
  "$schema": "../../scenario.schema.json",
  "id": "inbound/an-author-s-name-and-rank-are-recorded",
  "title": "A message whose author has a name carries its name, its rank among the sources whose names read alike, and its source",
  "rules": [
    "§10.1 step 12",
    "§6.4",
    "§5.5"
  ],
  "notes": "The room's participant p-alice, reached through sms, is named Alice; the second sender's transport stamps the name ALICE (metadata.sender_name), which reads like Alice.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ],
        "participants": [
          {
            "id": "p-alice",
            "channel_id": "sms",
            "display_name": "Alice",
            "connected_via": [
              "sms"
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "p-alice",
        "content": {
          "type": "text",
          "body": "Hi, Alice here"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15559876543",
        "content": {
          "type": "text",
          "body": "Hi, I'm Alice too"
        },
        "metadata": {
          "sender_name": "ALICE"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "p-alice",
        "content": {
          "type": "text",
          "body": "Alice again"
        }
      }
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15550000000",
        "content": {
          "type": "text",
          "body": "No name"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "metadata": {
            "author": {
              "name": "Alice",
              "rank": 1,
              "source": {
                "$present": true
              }
            }
          }
        },
        {
          "metadata": {
            "author": {
              "name": "ALICE",
              "rank": 2,
              "source": {
                "$present": true
              }
            }
          }
        },
        {
          "metadata": {
            "author": {
              "name": "Alice",
              "rank": 1,
              "source": {
                "$present": true
              }
            }
          }
        },
        {
          "metadata": {
            "author": {
              "$absent": true
            }
          }
        }
      ]
    }
  }
}
