{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-session-is-active-from-its-start-and-ended-once-left",
  "title": "A session the transport created connected reads active once joined, and ended once the participant left",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-053"
  ],
  "notes": "The integrator's leave is the cause shown; PAUSED, a hang-up and a timeout are not.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ]
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "sessions": {
            "alice": [
              {
                "session_id": {
                  "$as": "first"
                },
                "state": "active"
              }
            ]
          }
        }
      }
    },
    {
      "call": "voice.leave",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "sessions": {
            "alice": [
              {
                "session_id": {
                  "$as": "first"
                },
                "state": "ended"
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {}
}
