{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-participant-who-comes-back-gets-a-new-session",
  "title": "A participant who left and joins again is given a session of another id, the ended one staying ended",
  "rules": [
    "§12.2"
  ],
  "requirements": [
    "RK-12.2-054",
    "RK-12.2-055"
  ],
  "notes": "The framework's own renegotiation back to CONNECTING (a realtime provider reconnected) is not shown.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ]
    },
    {
      "call": "voice.leave",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "call": "voice.join",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "sessions": {
            "alice": [
              {
                "session_id": {
                  "$as": "first"
                },
                "state": "ended"
              },
              {
                "session_id": {
                  "$as": "second"
                },
                "state": "active"
              }
            ]
          }
        }
      }
    }
  ],
  "expect": {}
}
