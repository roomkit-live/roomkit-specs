{
  "$schema": "../../scenario.schema.json",
  "id": "voice/without-a-streaming-stt-the-detector-judges-the-duration-once-min-speech-ms-has-passed",
  "title": "Under SEMANTIC without a streaming STT, the detector is consulted once min_speech_ms of speech has passed, with no transcript, on the speech's duration",
  "rules": [
    "§12.3.13"
  ],
  "requirements": [
    "RK-12.3.13-019",
    "RK-12.3.13-020"
  ],
  "notes": "The speech never ends and no word comes: the verdict is on its duration alone. How long the wait lasted is not measured.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async",
        "reactions": [
          {
            "gate": "cutting"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "playback_gates": [
        "playing"
      ],
      "vad": [
        {
          "type": "speech_start"
        }
      ],
      "transcripts": [
        "Wait"
      ],
      "interruption": {
        "min_speech_ms": 1
      },
      "backchannel_decisions": [
        {
          "is_backchannel": false
        }
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Your table is ready.",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "wait_for": "cutting"
    },
    {
      "open": "cutting"
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    },
    {
      "call": "voice.read",
      "channel_id": "phone",
      "expect": {
        "result": {
          "backchannel_contexts": [
            {
              "transcript": "",
              "speech_duration_ms": {
                "$present": true
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
