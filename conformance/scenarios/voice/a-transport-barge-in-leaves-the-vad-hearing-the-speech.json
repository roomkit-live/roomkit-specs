{
  "$schema": "../../scenario.schema.json",
  "id": "voice/a-transport-barge-in-leaves-the-vad-hearing-the-speech",
  "title": "While a reply plays, the transport signals a barge-in on the caller's audio and ON_BARGE_IN fires; the same audio still reaches the VAD, whose speech start follows",
  "rules": [
    "§12.6"
  ],
  "requirements": [
    "RK-12.6-016"
  ],
  "notes": "The transport's signal comes first, as it detects the speech before the frames reach the pipeline; the IMMEDIATE strategy acts on it. A strategy that declines to act is not shown.",
  "requires_features": [
    "voice"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ],
    "hooks": [
      {
        "name": "cut",
        "trigger": "on_barge_in",
        "execution": "async"
      },
      {
        "name": "speech",
        "trigger": "on_speech_start",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "voice.open",
      "channel_id": "phone",
      "room_id": "r1",
      "participants": [
        "alice"
      ],
      "capabilities": [
        "interruption",
        "barge_in"
      ],
      "playback_gate": "playing",
      "vad": [
        {
          "type": "speech_start"
        }
      ]
    },
    {
      "call": "voice.say",
      "channel_id": "phone",
      "participant_id": "alice",
      "text": "Still speaking",
      "background": true,
      "as": "reply"
    },
    {
      "wait_for": "playing"
    },
    {
      "call": "voice.barge_in",
      "channel_id": "phone",
      "participant_id": "alice"
    },
    {
      "call": "voice.feed",
      "channel_id": "phone",
      "participant_id": "alice",
      "frames": [
        "AQI="
      ]
    },
    {
      "open": "playing"
    },
    {
      "await": "reply"
    },
    {
      "call": "voice.settle",
      "channel_id": "phone"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "cut": [
        {
          "voice": {
            "participant_id": "alice",
            "interrupted_text": "Still speaking"
          }
        }
      ],
      "speech": [
        {
          "voice": {
            "participant_id": "alice"
          }
        }
      ]
    }
  }
}
