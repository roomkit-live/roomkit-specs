{
  "$schema": "../../scenario.schema.json",
  "id": "delivery/a-close-from-the-answer-s-own-sender-drops-what-its-lane-kept",
  "title": "An aftermath hook sends an answer then closes the kit without delivering that retained answer",
  "rules": [
    "§12.10.4",
    "§10.1 step 13"
  ],
  "notes": "Python: tests/test_kit_close_doors.py::test_a_close_from_the_lane_s_own_work_drops_what_it_kept_and_the_lane_ends. The named close action must actually finish; the complete websocket delivery list is the observable contract.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms"
      },
      {
        "id": "ws",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "reply-and-close",
        "trigger": "after_broadcast",
        "execution": "async",
        "reactions": [
          {
            "when": {
              "text": "Hi."
            },
            "do": [
              {
                "call": "send_event",
                "room_id": "room-1",
                "channel_id": "sms",
                "content": {
                  "type": "text",
                  "body": "Hello."
                },
                "as": "reply"
              },
              {
                "call": "close",
                "as": "closed"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u",
        "content": {
          "type": "text",
          "body": "Hi."
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "Hi."
          }
        },
        {
          "content": {
            "body": "Hello."
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "body": "Hi."
            }
          }
        ]
      }
    },
    "actions": {
      "closed": [
        {
          "result": null
        }
      ],
      "reply": [
        {
          "result": {
            "content": {
              "body": "Hello."
            }
          }
        }
      ]
    }
  }
}
