{
  "$schema": "../../scenario.schema.json",
  "id": "executor-close/closing-from-a-nested-turn-spares-its-ancestors",
  "title": "A nested turn closing its executor lets itself and the ancestor turn finish",
  "rules": [
    "§10.6.7",
    "§10.6.8"
  ],
  "notes": "Python: TurnExecutor._spare_turns_run_under spares every turn the close runs under, including ancestors in other rooms.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "nested"
            },
            {
              "text": "outer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      },
      {
        "id": "transport",
        "bindings": [
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "kit_executor.hook",
      "hook": {
        "name": "lifecycle",
        "trigger": "before_ai_generation",
        "reactions": [
          {
            "when": {
              "room_id": "r1"
            },
            "do": [
              {
                "call": "process_inbound",
                "room_id": "r2",
                "message": {
                  "channel_id": "ws",
                  "sender_id": "alice",
                  "content": {
                    "type": "text",
                    "body": "hello"
                  }
                },
                "expect": {
                  "result": {
                    "blocked": false,
                    "error": null
                  }
                }
              }
            ]
          },
          {
            "when": {
              "room_id": "r2"
            },
            "do": [
              {
                "call": "kit_executor.close",
                "expect": {
                  "result": null
                }
              }
            ]
          }
        ]
      }
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "call": "kit_executor.closed",
      "expect": {
        "result": true
      }
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "content": {
            "type": "text",
            "body": "hello"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "outer"
          }
        }
      ],
      "r2": [
        {
          "content": {
            "type": "text",
            "body": "hello"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "nested"
          }
        }
      ]
    },
    "models": {
      "agent": [
        {},
        {}
      ]
    }
  }
}
