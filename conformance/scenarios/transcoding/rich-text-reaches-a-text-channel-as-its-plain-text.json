{
  "$schema": "../../scenario.schema.json",
  "id": "transcoding/rich-text-reaches-a-text-channel-as-its-plain-text",
  "title": "A rich content reaches a channel that does not carry RICH as its plain text, else its body, and a rich channel unchanged",
  "rules": [
    "§6.6",
    "§10.2 step 3c",
    "§5.8"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "console",
        "type": "websocket",
        "category": "transport",
        "capabilities": {
          "media_types": [
            "text",
            "rich",
            "media",
            "location"
          ]
        }
      },
      {
        "id": "ws_rich",
        "type": "websocket",
        "category": "transport",
        "capabilities": {
          "media_types": [
            "text",
            "rich"
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "console"
          },
          {
            "channel_id": "ws_rich"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "console",
      "content": {
        "type": "rich",
        "body": "**Hi** there",
        "format": "markdown",
        "plain_text": "Hi there"
      }
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "console",
      "content": {
        "type": "rich",
        "body": "**Hi** there",
        "format": "markdown"
      }
    }
  ],
  "expect": {
    "deliveries": {
      "room-1": {
        "sms": [
          {
            "content": {
              "type": "text",
              "body": "Hi there"
            }
          },
          {
            "content": {
              "type": "text",
              "body": "**Hi** there"
            }
          }
        ],
        "ws_rich": [
          {
            "content": {
              "type": "rich",
              "body": "**Hi** there",
              "plain_text": "Hi there"
            }
          },
          {
            "content": {
              "type": "rich",
              "body": "**Hi** there"
            }
          }
        ]
      }
    },
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "rich"
          }
        },
        {
          "content": {
            "type": "rich"
          }
        }
      ]
    }
  }
}
