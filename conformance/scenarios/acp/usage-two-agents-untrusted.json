      },
      {
        "id": "one",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "usage_update",
                    "used": 0,
                    "size": 100,
                    "_meta": {
                      "roomkit.live/usage": {
                        "usage_protocol": 1,
                        "session_id": "one-session",
                        "session_epoch": "epoch-1",
                        "node_id": "node-1",
                        "agent_id": "one",
                        "adapter_info": "{\"name\":\"test-adapter\",\"version\":\"1.0\"}",
                        "result_id": "result-2",
                        "turn_id": "turn-2",
                        "generation": 0,
                        "replayed": true,
                        "usage_report": {
