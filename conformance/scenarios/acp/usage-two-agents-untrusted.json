                    "node_id": "node-1",
                    "agent_id": "one",
                    "adapter_info": "{\"name\":\"test-adapter\",\"version\":\"1.0\"}",
                    "result_id": "result-2",
                    "turn_id": "turn-2",
                    "generation": 0,
