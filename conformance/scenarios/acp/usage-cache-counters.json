{
  "$schema": "../../scenario.schema.json",
  "id": "acp/usage-cache-counters",
  "title": "ACP preserves both cache counters and the reported total",
  "rules": [
    "§6.4",
    "Appendix A.9.1"
  ],
  "notes": "Python: tests/test_channels/test_acp.py::TestEndOfTurnReport::test_cache_counters_survive_the_report. Read the real response hook; compare reported numbers without arithmetic.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "usage": {
                  "inputTokens": 2,
                  "outputTokens": 3,
                  "totalTokens": 27369,
                  "cachedReadTokens": 16997,
                  "cachedWriteTokens": 10367
                }
              }
            ],
            "initialize": {
              "agent_info": {
                "name": "scripted-agent",
                "version": "1.0.0"
              }
            }
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "first"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "response": [
        {
          "trigger": "on_ai_response",
          "room_id": "room-1",
          "response": {
            "channel_id": "claude",
            "usage": {
              "input_tokens": 2,
              "output_tokens": 3,
              "total_tokens": 27369,
              "cached_read_tokens": 16997,
              "cached_write_tokens": 10367
            }
          }
        }
      ]
    }
  }
}
