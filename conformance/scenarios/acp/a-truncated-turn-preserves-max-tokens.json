{
  "$schema": "../../scenario.schema.json",
  "id": "acp/a-truncated-turn-preserves-max-tokens",
  "title": "An ACP answer truncated at max_tokens preserves that reason in the result, timeline and response hook",
  "rules": [
    "§6.4"
  ],
  "notes": "Python: tests/test_channels/test_acp.py::TestTurnOutcomeMetadata::test_a_truncated_turn_is_named_too. This case exercises max_tokens explicitly; the refusal case alone does not cover that variant.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "claude",
        "type": "ai",
        "acp": {
          "cwd": "/srv/project",
          "agent": {
            "prompts": [
              {
                "updates": [
                  {
                    "sessionUpdate": "agent_message_chunk",
                    "content": {
                      "type": "text",
                      "text": "Partial answer"
                    }
                  }
                ],
                "stop_reason": "max_tokens"
              }
            ],
            "initialize": {
              "agent_info": {
                "name": "scripted-agent",
                "version": "1.0.0"
              }
            }
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "claude",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "response",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Do it"
        }
      },
      "expect": {
        "result": {
          "response_metadata": {
            "acp": {
              "protocol_version": 1,
              "prompt_returned": true,
              "stop_reason": "max_tokens"
            },
            "turns": {
              "claude": {
                "loop_end_reason": "max_tokens"
              }
            }
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0
        },
        {
          "index": 1,
          "content": {
            "body": "Partial answer"
          },
          "metadata": {
            "acp": {
              "stop_reason": "max_tokens"
            }
          }
        }
      ]
    },
    "hooks": {
      "response": [
        {
          "trigger": "on_ai_response",
          "room_id": "room-1",
          "response": {
            "channel_id": "claude",
            "response_content": "Partial answer",
            "loop_end_reason": "max_tokens",
            "usage": {}
          }
        }
      ]
    }
  }
}
