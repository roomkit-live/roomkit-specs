{
  "$schema": "../../scenario.schema.json",
  "id": "regenerate/the-room-takes-a-message-while-its-agent-regenerates",
  "title": "While a regenerated turn generates, the room takes a new message: the regeneration holds no room lock past its choice",
  "rules": [
    "§13.6",
    "§13.5"
  ],
  "notes": "Python: tests/test_regenerate_off_lock.py::test_the_room_takes_a_message_while_the_agent_regenerates. The new message's delivery waits in the room's lane behind the regenerated turn, so it is deferred.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "First answer"
            },
            {
              "text": "Regenerated"
            },
            {
              "text": "Second answer"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "first"
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "register_hook",
      "hook": {
        "name": "slow",
        "trigger": "before_ai_generation",
        "reactions": [
          {
            "gate": "regen"
          }
        ]
      }
    },
    {
      "call": "regenerate_response",
      "room_id": "room-1",
      "background": true,
      "as": "r"
    },
    {
      "wait_for": "regen"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "second"
        }
      },
      "defer_delivery": true,
      "as": "second",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "content": {
              "body": "second"
            }
          }
        }
      }
    },
    {
      "open": "regen"
    },
    {
      "await": "r",
      "expect": {
        "result": {
          "event": {
            "id": "room-1#0"
          },
          "blocked": false,
          "response_events": [
            {
              "content": {
                "body": "Regenerated"
              }
            }
          ]
        }
      }
    },
    {
      "call": "delivery.wait",
      "of": "second",
      "expect": {
        "result": {
          "blocked": false
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "body": "first"
          }
        },
        {
          "content": {
            "body": "First answer"
          }
        },
        {
          "content": {
            "body": "second"
          }
        },
        {
          "content": {
            "body": "Regenerated"
          }
        },
        {
          "content": {
            "body": "Second answer"
          }
        }
      ]
    }
  }
}
