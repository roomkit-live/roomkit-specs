{
  "$schema": "../../scenario.schema.json",
  "id": "discussion/a-delivery-naming-an-agent-queues-it-at-the-back",
  "title": "A delivery naming an agent queues it at the back, behind the agents already queued, where a person's message would put it first",
  "rules": [
    "§19.7.5 rule 2",
    "§19.7.5 rule 8",
    "§22.1"
  ],
  "requirements": [
    "RK-19.7.5-030",
    "RK-19.7.5-075"
  ],
  "notes": "While a's turn holds, c is queued by the person's message; the delivery names b, which goes behind c, and the turns run a, c, b.",
  "setup": {
    "channels": [
      {
        "id": "ops",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "a done",
              "gate": "a-held"
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "b done"
            }
          ]
        }
      },
      {
        "id": "c",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "c done"
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "ops"
          }
        ]
      }
    ],
    "strategies": [
      {
        "id": "d",
        "discussion": {
          "agents": [
            "a",
            "b",
            "c"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "d"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "ops",
        "sender_id": "oncall",
        "content": {
          "type": "text",
          "body": "@a @c go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "wait_for": "a-held"
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": "a",
          "queue": [
            "c"
          ]
        }
      }
    },
    {
      "call": "deliver",
      "room_id": "r1",
      "content": "the nightly job finished",
      "channel_id": "ops",
      "addressed_to": [
        "b"
      ],
      "expect": {
        "result": {
          "error": null
        }
      }
    },
    {
      "call": "speak_queue",
      "room_id": "r1",
      "expect": {
        "result": {
          "speaking": "a",
          "queue": [
            "c",
            "b"
          ]
        }
      }
    },
    {
      "open": "a-held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "r1": [
        {
          "source": {
            "channel_id": "ops"
          },
          "content": {
            "body": "@a @c go"
          }
        },
        {
          "content": {
            "body": "the nightly job finished"
          },
          "addressed_to": [
            "b"
          ]
        },
        {
          "source": {
            "channel_id": "a"
          },
          "content": {
            "body": "a done"
          }
        },
        {
          "source": {
            "channel_id": "c"
          },
          "content": {
            "body": "c done"
          }
        },
        {
          "source": {
            "channel_id": "b"
          },
          "content": {
            "body": "b done"
          }
        }
      ]
    }
  }
}
