{
  "$schema": "../../scenario.schema.json",
  "id": "chain/the-hook-calls-stop-a-before-broadcast-observer-loop",
  "title": "An ASYNC hook of BEFORE_BROADCAST that injects on every event it observes stops at its cascade's hook calls, each injection one deeper",
  "rules": [
    "§8.3 The hook calls of a cascade",
    "§8.3",
    "§9.2",
    "§9.5.1 The room's work outside the lock"
  ],
  "notes": "An ASYNC hook of a SYNC trigger observes the event its chain allowed as the cascade's work: a call from its body draws one of the cascade's 10 x max_chain_depth hook calls and is one deeper than the hook's event, as an AFTER_BROADCAST body's does.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "echo",
        "trigger": "before_broadcast",
        "execution": "async",
        "reactions": [
          {
            "repeat": true,
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "ws",
                "content": {
                  "type": "text",
                  "body": "again"
                },
                "as": "again"
              }
            ]
          }
        ]
      }
    ],
    "kit": {
      "max_chain_depth": 1
    }
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "start"
        }
      }
    }
  ],
