{
  "$schema": "../../scenario.schema.json",
  "id": "tools/an-agent-s-owner-tools-are-declared-in-the-order-they-were-set-up",
  "title": "The tools the room's owner serves an agent are declared in the order they were set up, a tool whose call waits by design among them: delegate_task set up before work_in_background is declared before it",
  "rules": [
    "§6.4",
    "§10.6.5",
    "§23.4"
  ],
  "notes": "Python: channels/_tool_registry.py ChannelRegistry.entries and owner_entries, each in the order they were registered; turns/_executor_calls.py TurnOwnerTools built from the request's owner_tools in their order. tasks/delegate.py _served_entry sets delegate_task up as waiting by design (waits=True), core/mixins/background.py setup_background work_in_background as bounded.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "speaker",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Hello."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "speaker"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate_handler",
      "handler": "tool"
    },
    {
      "call": "setup_delegation",
      "agent_id": "speaker",
      "handler": "tool"
    },
    {
      "call": "setup_background",
      "agent_id": "speaker"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hi"
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "speaker": [
        {
          "tools": {
            "delegate_task": 0,
            "work_in_background": 1
          }
        }
      ]
    }
  }
}
