{
  "$schema": "../../scenario.schema.json",
  "id": "tools/before-tool-use-fails-closed",
  "title": "BEFORE_TOOL_USE gates each call: a BLOCK refuses it with the hook's reason, a hook that raises or times out refuses it with the fixed text, and a hook that allows lets it run",
  "rules": [
    "§9.3",
    "§21.1"
  ],
  "notes": "BEFORE_TOOL_USE fails closed (§9.3): an error or a timeout refuses the call. The model reads the fixed refusal, never the hook's error, which reaches the observers on error_detail with the hook's name. One call per round, so the hook's reactions are used in the rounds' order.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ],
              "finish_reason": "tool_calls"
            },
            {
              "calls": [
                {
                  "id": "call-2",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "2"
                  }
                }
              ],
              "finish_reason": "tool_calls"
            },
            {
              "calls": [
                {
                  "id": "call-3",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "3"
                  }
                }
              ],
              "finish_reason": "tool_calls"
            },
            {
              "calls": [
                {
                  "id": "call-4",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "4"
                  }
                }
              ],
              "finish_reason": "tool_calls"
            },
            {
              "text": "Order 4 is ready.",
              "finish_reason": "stop"
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              },
              "required": [
                "order"
              ]
            },
            "returns": "{\"order\": \"4\", \"status\": \"ready\"}"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "approve",
        "trigger": "before_tool_use",
        "timeout_ms": 50,
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "Needs a manager's approval"
            }
          },
          {
            "fail": "approval service down"
          },
          {
            "gate": "never-opened"
          }
        ]
      },
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Where are my orders?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Where are my orders?"
          }
        },
        {
