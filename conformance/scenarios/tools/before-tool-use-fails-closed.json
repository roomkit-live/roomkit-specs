          "content": {
            "type": "tool_call",
            "tool_name": "lookup_order",
            "tool_id": "call-1",
            "arguments": {
              "order": "1"
            },
            "status": "failed",
            "outcome": "refused",
            "result": "{\"error\": \"Needs a manager's approval\"}",
            "error": "{\"error\": \"Needs a manager's approval\"}"
          }
        },
        {
          "index": 3,
          "type": "tool_call_start",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
