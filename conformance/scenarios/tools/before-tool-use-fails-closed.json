            "result": null
          }
        },
        {
          "index": 6,
          "type": "tool_call_end",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "lookup_order",
            "tool_id": "call-3",
            "arguments": {
              "order": "3"
            },
            "status": "failed",
            "outcome": "refused",
            "result": "{\"error\": \"Tool 'lookup_order' denied by pre-execution hook.\"}",
            "error": "{\"error\": \"Tool 'lookup_order' denied by pre-execution hook.\"}"
          }
        },
        {
          "index": 7,
          "type": "tool_call_start",
          "source": {
