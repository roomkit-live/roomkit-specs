            "tool_name": "lookup_order",
            "tool_id": "call-4",
            "arguments": {
              "order": "4"
            },
            "status": "pending",
            "result": null
          }
        },
        {
          "index": 8,
          "type": "tool_call_end",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "lookup_order",
            "tool_id": "call-4",
            "arguments": {
              "order": "4"
            },
            "status": "completed",
            "outcome": "served",
            "result": "{\"order\": \"4\", \"status\": \"ready\"}",
            "error": null
          }
        },
        {
          "index": 9,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "text",
            "body": "Order 4 is ready."
          },
          "metadata": {
            "loop_end_reason": "completed"
          }
        }
      ]
    },
    "hooks": {
      "approve": [
        {
          "trigger": "before_tool_use",
          "room_id": "room-1",
          "tool_call": {
            "name": "lookup_order",
            "tool_call_id": "call-1",
            "arguments": {
              "order": "1"
            }
          }
        },
        {
          "trigger": "before_tool_use",
          "room_id": "room-1",
          "tool_call": {
            "name": "lookup_order",
            "tool_call_id": "call-2",
            "arguments": {
              "order": "2"
            }
          }
        },
        {
          "trigger": "before_tool_use",
          "room_id": "room-1",
          "tool_call": {
            "name": "lookup_order",
            "tool_call_id": "call-3",
            "arguments": {
