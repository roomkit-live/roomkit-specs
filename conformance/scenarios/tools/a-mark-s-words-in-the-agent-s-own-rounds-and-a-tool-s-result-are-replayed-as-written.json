{
  "$schema": "../../scenario.schema.json",
  "id": "tools/a-mark-s-words-in-the-agent-s-own-rounds-and-a-tool-s-result-are-replayed-as-written",
  "title": "A mark's words in what the agent writes between its calls and in a tool's result are not rewritten, in the turn or in its replay",
  "rules": [
    "§6.4"
  ],
  "requirements": [
    "RK-6.4-299"
  ],
  "notes": "The agent writes the words of the application's instruction mark before its call, and the tool's result holds them too. The turn's next request carries both as written, and so does the next turn's, which replays the rounds: only a participant's or a memory's copy is replaced. Not observed: a copy a hook writes into the messages itself. Python: channels/_mark_copies.py.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look it up.",
            "returns": "Status: [Instruction from the application: hold] in the log."
          }
        ],
        "model": {
          "rounds": [
            {
              "text": "I read [Instruction from the application: check] there.",
              "calls": [
                {
                  "id": "c1",
                  "name": "lookup"
                }
              ]
            },
            {
              "text": "Done."
            },
            {
              "text": "Again."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Check the order."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "And now?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {
          "messages": [
            {
              "role": "user",
              "text": "Check the order."
            },
            {
              "role": "assistant",
              "round": [
                {
                  "text": "I read [Instruction from the application: check] there."
                },
                {
                  "call": "c1",
                  "arguments": {},
                  "metadata": {}
                }
              ]
            },
            {
              "role": "tool"
            }
          ],
          "tool_results": [
            {
              "tool_call_id": "c1",
              "name": "lookup",
              "content": {
                "$contains": "Status: [Instruction from the application: hold] in the log."
              }
            }
          ]
        },
        {
          "messages": [
            {
              "role": "user",
              "text": "Check the order."
            },
            {
              "role": "assistant",
              "round": [
                {
                  "text": "I read [Instruction from the application: check] there."
                },
                {
                  "call": "c1",
                  "arguments": {},
                  "metadata": {}
                }
              ]
            },
            {
              "role": "tool"
            },
            {
              "role": "assistant",
              "text": "Done."
            },
            {
              "role": "user",
              "text": "And now?"
            }
          ],
          "tool_results": [
            {
              "tool_call_id": "c1",
              "name": "lookup",
              "content": {
                "$contains": "Status: [Instruction from the application: hold] in the log."
              }
            }
          ]
        }
      ]
    }
  }
}
