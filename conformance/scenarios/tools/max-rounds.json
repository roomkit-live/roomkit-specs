{
  "$schema": "../../scenario.schema.json",
  "id": "tools/max-rounds",
  "title": "The tool loop runs at most max_tool_rounds rounds of calls: the generation past them stores its text, runs none of its calls and ends the turn max_rounds",
  "rules": [
    "Appendix A.9",
    "§6.4"
  ],
  "notes": "max_tool_rounds is 2: two rounds of calls run, the third generation's call is neither stored nor run, and its text carries the turn's record.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Order 1.",
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "1"
                  }
                }
              ],
              "finish_reason": "tool_calls"
            },
            {
              "text": "Order 2.",
              "calls": [
                {
                  "id": "call-2",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "2"
                  }
                }
              ],
              "finish_reason": "tool_calls"
            },
            {
              "text": "Order 3.",
              "calls": [
                {
                  "id": "call-3",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "3"
                  }
                }
              ],
              "finish_reason": "tool_calls"
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              },
              "required": [
                "order"
              ]
            },
            "returns": "{\"order\": \"42\", \"status\": \"shipped\"}"
          }
        ],
        "max_tool_rounds": 2
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "audit",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Check orders 1 to 3."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "ws"
          },
          "content": {
            "type": "text",
            "body": "Check orders 1 to 3."
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "text",
            "body": "Order 1."
          },
          "metadata": {
            "loop_end_reason": {
              "$absent": true
            }
          }
        },
        {
          "index": 2,
          "type": "tool_call_start",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "lookup_order",
            "tool_id": "call-1",
            "arguments": {
              "order": "1"
            },
            "status": "pending",
            "result": null
          }
        },
        {
          "index": 3,
          "type": "tool_call_end",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "lookup_order",
            "tool_id": "call-1",
            "arguments": {
              "order": "1"
            },
            "status": "completed",
            "outcome": "served",
            "result": "{\"order\": \"42\", \"status\": \"shipped\"}",
            "error": null
          }
        },
        {
          "index": 4,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "text",
            "body": "Order 2."
          },
          "metadata": {
            "loop_end_reason": {
              "$absent": true
            }
          }
        },
        {
          "index": 5,
          "type": "tool_call_start",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "lookup_order",
            "tool_id": "call-2",
            "arguments": {
              "order": "2"
            },
            "status": "pending",
            "result": null
          }
        },
        {
          "index": 6,
          "type": "tool_call_end",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "tool_call",
            "tool_name": "lookup_order",
            "tool_id": "call-2",
            "arguments": {
              "order": "2"
            },
            "status": "completed",
            "outcome": "served",
            "result": "{\"order\": \"42\", \"status\": \"shipped\"}",
            "error": null
          }
        },
        {
          "index": 7,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "content": {
            "type": "text",
            "body": "Order 3."
          },
          "metadata": {
            "loop_end_reason": "max_rounds"
          }
        }
      ]
    },
    "hooks": {
      "audit": [
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "lookup_order",
            "tool_call_id": "call-1",
            "arguments": {
              "order": "1"
            },
            "result": "{\"order\": \"42\", \"status\": \"shipped\"}",
            "is_error": false,
            "refused": false,
            "cancelled": false,
            "error_detail": null
          }
        },
        {
          "trigger": "on_tool_call",
          "room_id": "room-1",
          "tool_call": {
            "name": "lookup_order",
            "tool_call_id": "call-2",
            "arguments": {
              "order": "2"
            },
            "result": "{\"order\": \"42\", \"status\": \"shipped\"}",
            "is_error": false,
            "refused": false,
            "cancelled": false,
            "error_detail": null
          }
        }
      ]
    },
    "models": {
      "agent": [
        {
          "tool_results": []
        },
        {
          "tool_results": [
            {
              "tool_call_id": "call-1",
              "content": "{\"order\": \"42\", \"status\": \"shipped\"}"
            }
          ]
        },
        {
          "tool_results": [
            {
              "tool_call_id": "call-1",
              "content": "{\"order\": \"42\", \"status\": \"shipped\"}"
            },
            {
              "tool_call_id": "call-2",
              "content": "{\"order\": \"42\", \"status\": \"shipped\"}"
            }
          ]
        }
      ]
    }
  }
}
