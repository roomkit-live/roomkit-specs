{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/a-message-an-off-lock-hook-blocks-keeps-its-ticket-place",
  "title": "A message an off-lock hook blocks still waits for its turn: its BLOCKED record commits ahead of a later message whose check ended first",
  "rules": [
    "§9.5.1",
    "§9.5.1 Order",
    "§9.5.1 Release",
    "§10.1 step 5a",
    "§10.1 step 10"
  ],
  "requirements": [
    "RK-9.5.1-005",
    "RK-9.5.1-006"
  ],
  "notes": "The variant of hooks/off-lock-tickets-keep-arrival-order where the first message's check, ended last, blocks it. Python: tests/test_off_lock_check.py::TestOrderAndOverlap::test_blocked_first_message_releases_the_next.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "scan",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "when": {
              "text": "first"
            },
            "gate": "first",
            "result": {
              "action": "block",
              "reason": "pii"
            }
          },
          {
            "when": {
              "text": "second"
            },
            "gate": "second"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "first"
        }
      },
      "background": true,
      "as": "first"
    },
    {
      "wait_for": "first"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "second"
        }
      },
      "background": true,
      "as": "second"
    },
    {
      "wait_for": "second"
    },
    {
      "open": "second"
    },
    {
      "open": "first"
    },
    {
      "await": "first",
      "expect": {
        "result": {
          "blocked": true,
          "event": {
            "index": 0,
            "status": "blocked",
            "blocked_by": "scan"
          }
        }
      }
    },
    {
      "await": "second",
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "index": 1
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "first"
          },
          "status": "blocked",
          "blocked_by": "scan"
        },
        {
          "content": {
            "type": "text",
            "body": "second"
          },
          "status": "delivered"
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "type": "text",
              "body": "second"
            }
          }
        ]
      }
    }
  }
}
