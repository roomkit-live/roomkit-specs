{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/a-failing-off-lock-hook-is-reported-before-the-lock",
  "title": "An off-lock hook that raises is reported as hook_error when it is met, before the lock, and its event goes through",
  "rules": [
    "§10.1 step 5a",
    "§9.5.1 Errors",
    "§9.3",
    "§26.1"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "scan",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "fail": "the scanner is down"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "status": "delivered"
        }
      ]
    },
    "framework_events": {
      "room-1": [
        {
          "event": "hook_error",
          "hook": "scan",
          "event_id": "room-1#0"
        },
        {
          "$unordered": [
            {
              "event": "delivery_succeeded",
              "channel_id": "ws"
            },
            {
              "event": "event_processed"
            }
          ]
        }
      ]
    }
  }
}
