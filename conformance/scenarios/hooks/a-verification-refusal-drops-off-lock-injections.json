{
  "$schema": "../../scenario.schema.json",
  "id": "hooks/a-verification-refusal-drops-off-lock-injections",
  "title": "A verification gate that stores no cause drops the injections already collected off lock",
  "rules": [
    "§9.4 Injected events"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notify",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "result": {
              "action": "allow",
              "injected_events": [
                {
                  "event": {
                    "content": {
                      "type": "text",
                      "body": "notice"
                    }
                  },
                  "target_channel_ids": [
                    "ws"
                  ]
                }
              ]
            }
          }
        ],
        "needs_lock": false
      },
      {
        "name": "verify",
        "trigger": "on_verification_required",
        "reactions": [
          {
            "result": {
              "action": "block",
              "reason": "not verified"
            }
          }
        ]
      }
    ],
    "kit": {
      "identity_resolver": {
        "answers": [
          {
            "repeat": true,
            "result": {
              "status": "identified",
              "identity": {
                "id": "alice-id"
              }
            }
          }
        ]
      },
      "verification_policy": {}
    }
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "event": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": []
    },
    "deliveries": {
      "room-1": {
        "ws": []
      }
    },
    "hooks": {
      "notify": [
        {
          "event": {
            "content": {
              "type": "text",
              "body": "hello"
            }
          }
        }
      ],
      "verify": [
        {
          "event": {
            "content": {
              "type": "text",
              "body": "hello"
            }
          }
        }
      ]
    }
  }
}
