{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-result-submitted-before-the-worker-s-failure-still-counts",
  "title": "A structured delegation whose worker submits its result completes with the submitted payload, normalized: its turn ends at the served call, so the failure its next generation would give never comes",
  "rules": [
    "§23.3"
  ],
  "notes": "Python: tests/tasks/test_structured_result.py::TestATurnEndsOnItsServedResult::test_the_model_is_asked_once; core/mixins/_result_capture.py capture_result (the result tool ends the turn), channels/_ai_streaming.py. The worker's model is asked once: the turn ends once its submit_result call is served (RMK-357), so the 529 its next generation would raise is never asked for.",
  "setup": {
    "channels": [
      {
        "id": "worker",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "text": "Submitting.",
              "calls": [
                {
                  "id": "s1",
                  "name": "submit_result",
                  "arguments": {
                    "status": "completed",
                    "summary": "found it",
                    "data": {}
                  }
                }
              ]
            },
            {
              "refuses": {
                "status": 529,
                "message": "overloaded 529"
              }
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "parent"
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "parent",
      "agent_id": "worker",
      "task": "Find it.",
      "wait": true,
      "require_structured_result": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "status": "completed",
            "output": "{\"status\": \"completed\", \"summary\": \"found it\", \"data\": {}, \"deliverables\": [], \"reason\": \"\"}",
            "error": null
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "worker": [
        {}
      ]
    }
  }
}
