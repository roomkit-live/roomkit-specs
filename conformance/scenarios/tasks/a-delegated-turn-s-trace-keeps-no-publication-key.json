{
  "$schema": "../../scenario.schema.json",
  "id": "tasks/a-delegated-turn-s-trace-keeps-no-publication-key",
  "title": "A delegated turn's trace is stored as its channel made it, but for an idempotency key in the framework's publication namespace, which it never keeps: a key of the channel's own stays",
  "rules": [
    "§23.3 step 5",
    "§22.1"
  ],
  "notes": "Python: core/mixins/_child_execution.py _persist_response_events and _TraceSink.commit commit each row through core/_publication_keys.py without_reserved_key: a row the framework writes as a channel made it never carries a key under roomkit:publication:, which only the delivery path writes (RFC §22.1).",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "worker",
        "type": "ai",
        "category": "intelligence",
        "on_event": [
          {
            "when": {
              "text": "Look it up."
            },
            "respond": [
              {
                "content": {
                  "type": "text",
                  "body": "Looking."
                },
                "idempotency_key": "roomkit:publication:k1"
              },
              {
                "content": {
                  "type": "text",
                  "body": "Found it."
                },
                "idempotency_key": "mine-1"
              }
            ]
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "delegate",
      "room_id": "room-1",
      "agent_id": "worker",
      "task": "Look it up.",
      "wait": true,
      "expect": {
        "result": {
          "status": "completed",
          "result": {
            "output": "Found it."
          }
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [],
      "$r1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "system"
          },
          "content": {
            "type": "text",
            "body": "Look it up."
          }
        },
        {
          "index": 1,
          "source": {
            "channel_id": "worker"
          },
          "content": {
            "type": "text",
            "body": "Looking."
          },
          "idempotency_key": null
        },
        {
          "index": 2,
          "source": {
            "channel_id": "worker"
          },
          "content": {
            "type": "text",
            "body": "Found it."
          },
          "idempotency_key": "mine-1"
        }
      ]
    }
  }
}
