{
  "$schema": "../../scenario.schema.json",
  "id": "conference/clearing-the-explicit-grants-returns-to-derived-ones",
  "title": "Explicit grants cleared on a running channel give way to the grants derived from its configuration",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-203"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "Derived grants cover the recognizer (subscribe) and never ask for moderate, whose default is false; how the rest is derived is §12.10.3's SHOULD, not asserted.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "expect": {
        "result": {
          "id": {
            "$as": "first"
          },
          "room_id": "r1"
        }
      }
    },
    {
      "call": "conference.set_bot_grants",
      "channel_id": "conf",
      "grants": {
        "publish_audio": true,
        "publish_video": false,
        "publish_screen_share": false,
        "subscribe": false,
        "moderate": true
      }
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "bots": [
            {
              "grants": {
                "subscribe": false,
                "moderate": true
              }
            }
          ]
        }
      }
    },
    {
      "call": "conference.set_bot_grants",
      "channel_id": "conf",
      "grants": null
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "expect": {
        "result": {
          "bots": [
            {
              "grants": {
                "subscribe": true,
                "moderate": false
              }
            }
          ]
        }
      }
    }
  ]
}
