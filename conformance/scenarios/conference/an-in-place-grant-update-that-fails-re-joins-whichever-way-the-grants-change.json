{
  "$schema": "../../scenario.schema.json",
  "id": "conference/an-in-place-grant-update-that-fails-re-joins-whichever-way-the-grants-change",
  "title": "When the backend fails to update the bot's grants in place, set_bot_grants re-joins, for a widening and for a narrowing alike",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-206"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The first set widens the bot's grants (video added), the second narrows them (audio and video withdrawn); each in-place update the backend fails is followed by a leave and a join with the grants asked.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1",
      "capabilities": [
        "bot_grant_update"
      ]
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "idle": true
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "update_bot_grants",
      "fail": "refused"
    },
    {
      "call": "conference.set_bot_grants",
      "channel_id": "conf",
      "grants": {
        "publish_audio": true,
        "subscribe": true,
        "publish_video": true
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.fault",
      "channel_id": "conf",
      "method": "update_bot_grants",
      "fail": "refused"
    },
    {
      "call": "conference.set_bot_grants",
      "channel_id": "conf",
      "grants": {
        "subscribe": true,
        "publish_audio": false,
        "publish_video": false,
        "publish_screen_share": false
      }
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot",
        "update_bot_grants",
        "leave"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "session": {
                "$as": "first"
              }
            },
            {
              "call": "update_bot_grants",
              "session": {
                "$as": "first"
              },
              "grants": {
                "publish_video": true
              }
            },
            {
              "call": "leave",
              "session": {
                "$as": "first"
              }
            },
            {
              "call": "join_as_bot",
              "session": {
                "$as": "second"
              },
              "grants": {
                "publish_video": true
              }
            },
            {
              "call": "update_bot_grants",
              "session": {
                "$as": "second"
              },
              "grants": {
                "publish_audio": false,
                "publish_video": false
              }
            },
            {
              "call": "leave",
              "session": {
                "$as": "second"
              }
            },
            {
              "call": "join_as_bot",
              "session": {
                "$as": "third"
              },
              "grants": {
                "publish_audio": false,
                "publish_video": false
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {}
}
