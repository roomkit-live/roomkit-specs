{
  "$schema": "../../scenario.schema.json",
  "id": "conference/grants-cover-the-needs-as-a-voice-is-plugged",
  "title": "A voice plugged beside the recognizer brings the bot back with grants to publish audio as well as to subscribe",
  "rules": [
    "§12.10.4"
  ],
  "requirements": [
    "RK-12.10.4-193"
  ],
  "requires_features": [
    "conference"
  ],
  "notes": "The backend cannot update grants in place, so the widening is a re-join.",
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.ensure_bot",
      "channel_id": "conf",
      "room_id": "r1",
      "expect": {
        "result": {
          "id": {
            "$as": "first"
          },
          "room_id": "r1"
        }
      }
    },
    {
      "call": "conference.plug",
      "channel_id": "conf",
      "kind": "tts"
    },
    {
      "idle": true
    },
    {
      "call": "conference.read",
      "channel_id": "conf",
      "calls": [
        "join_as_bot",
        "leave",
        "update_bot_grants"
      ],
      "expect": {
        "result": {
          "calls": [
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "first"
              },
              "grants": {
                "subscribe": true,
                "publish_audio": false
              }
            },
            {
              "call": "leave",
              "session": {
                "$as": "first"
              }
            },
            {
              "call": "join_as_bot",
              "room_id": "r1",
              "session": {
                "$as": "second"
              },
              "grants": {
                "subscribe": true,
                "publish_audio": true
              }
            }
          ]
        }
      }
    }
  ]
}
