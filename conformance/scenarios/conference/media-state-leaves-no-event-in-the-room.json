{
  "$schema": "../../scenario.schema.json",
  "id": "conference/media-state-leaves-no-event-in-the-room",
  "title": "Mute changes, speaker changes and quality reports are stored as no room event",
  "rules": [
    "§12.10.7"
  ],
  "requirements": [
    "RK-12.10.7-006"
  ],
  "requires_features": [
    "conference"
  ],
  "setup": {
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "conference.open",
      "channel_id": "conf",
      "room_id": "r1"
    },
    {
      "call": "conference.join",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.publish",
      "channel_id": "conf",
      "participant_id": "alice",
      "track_id": "mic",
      "kind": "audio"
    },
    {
      "idle": true
    },
    {
      "call": "get_timeline",
      "room_id": "r1",
      "expect": {
        "result": {
          "$as": "timeline"
        }
      }
    },
    {
      "call": "conference.mute",
      "channel_id": "conf",
      "track_id": "mic"
    },
    {
      "call": "conference.unmute",
      "channel_id": "conf",
      "track_id": "mic"
    },
    {
      "call": "conference.active_speaker",
      "channel_id": "conf",
      "participant_id": "alice"
    },
    {
      "call": "conference.connection_quality",
      "channel_id": "conf",
      "participant_id": "alice",
      "quality": "poor"
    },
    {
      "idle": true
    },
    {
      "call": "get_timeline",
      "room_id": "r1",
      "expect": {
        "result": {
          "$as": "timeline"
        }
      }
    }
  ],
  "expect": {}
}
