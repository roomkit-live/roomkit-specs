{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/an-off-lock-hook-reads-the-record-and-the-attach-routing-wrote",
  "title": "An off-lock hook's context is the room as routing left it: the routed sender recorded on the binding that named no one, and the channel attached to the routed room naming its sender",
  "rules": [
    "§9.5.1",
    "§10.1 step 2",
    "§10.1 step 3"
  ],
  "requirements": [
    "RK-9.5.1-015"
  ],
  "notes": "The router routes every message to room-1. Alice's SMS reaches the sms binding, which names no one: step 2 records her on it. Her WhatsApp message reaches a room that does not bind wa: step 2 attaches wa naming her. The off-lock hook's context, built at step 3 before the lock, holds each write.",
  "setup": {
    "kit": {
      "router": {
        "room_id": "room-1"
      }
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "wa",
        "type": "whatsapp",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "check",
        "trigger": "before_broadcast",
        "needs_lock": false
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "By SMS"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1",
            "index": 0
          }
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "wa",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "By WhatsApp"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "room_id": "room-1",
            "index": 1
          }
        }
      }
    }
  ],
  "expect": {
    "bindings": {
      "room-1": {
        "sms": {
          "participant_id": "+15551234567"
        },
        "wa": {
          "participant_id": "+15551234567"
        }
      }
    },
    "hooks": {
      "check": [
        {
          "trigger": "before_broadcast",
          "event": {
            "content": {
              "type": "text",
              "body": "By SMS"
            }
          },
          "context_bindings": [
            {
              "room_id": "room-1",
              "channel_id": "sms",
              "participant_id": "+15551234567"
            }
          ]
        },
        {
          "trigger": "before_broadcast",
          "event": {
            "content": {
              "type": "text",
              "body": "By WhatsApp"
            }
          },
          "context_bindings": {
            "$unordered": [
              {
                "room_id": "room-1",
                "channel_id": "sms",
                "participant_id": "+15551234567"
              },
              {
                "room_id": "room-1",
                "channel_id": "wa",
                "participant_id": "+15551234567"
              }
            ]
          }
        }
      ]
    }
  }
}
