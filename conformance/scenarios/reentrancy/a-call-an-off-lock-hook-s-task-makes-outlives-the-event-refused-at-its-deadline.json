{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/a-call-an-off-lock-hook-s-task-makes-outlives-the-event-refused-at-its-deadline",
  "title": "A call a task of an off-lock hook makes, adopted beside the check, outlives the event: the event is refused at its process_timeout while the call holds the room's lock, and the call commits within its own",
  "rules": [
    "§9.5.1 Reentrance",
    "§13.6"
  ],
  "requirements": [
    "RK-9.5.1-039"
  ],
  "reentrancy": [
    "inject@admitted"
  ],
  "notes": "process_timeout is 1 s. The off-lock hook's body starts the task and never returns; 500 ms in, the task sends, and a locked hook holds that call at its gate, under the room's lock, past the event's deadline. Its own deadline runs from its start, 500 ms after the event's: opened once the event is refused, it commits. Python: tests/test_reentrance.py::TestAnAdoptedCallBeforeItsCommit::test_a_call_a_hook_s_task_makes_keeps_its_own_deadline.",
  "setup": {
    "kit": {
      "process_timeout_ms": 1000
    },
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "notifier",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "timeout_ms": 5000,
        "reactions": [
          {
            "when": {
              "text": "hello"
            },
            "spawn": {
              "delay_ms": 500,
              "do": [
                {
                  "call": "send_event",
                  "room_id": "$room",
                  "channel_id": "ws",
                  "content": {
                    "type": "text",
                    "body": "heads up"
                  },
                  "as": "notice"
                }
              ]
            },
            "gate": "never"
          }
        ]
      },
      {
        "name": "slow",
        "trigger": "before_broadcast",
        "timeout_ms": 5000,
        "reactions": [
          {
            "when": {
              "text": "heads up"
            },
            "gate": "slow_held"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "background": true,
      "as": "hello"
    },
    {
      "wait_for": "slow_held"
    },
    {
      "await": "hello",
      "expect": {
        "result": {
          "blocked": true,
          "reason": "process_timeout",
          "event": null
        }
      }
    },
    {
      "open": "slow_held"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "heads up"
          }
        }
      ]
    },
    "actions": {
      "notice": [
        {
          "result": {
            "id": "room-1#0"
          }
        }
      ]
    }
  }
}
