{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/a-locked-hook-s-injection-commits-ahead",
  "title": "An injection a locked hook makes into its room is adopted: it commits ahead of the event, and is delivered first",
  "rules": [
    "§9.5.1 Reentrance",
    "§13.5",
    "§10.5",
    "§10.1 step 9a"
  ],
  "reentrancy": [
    "inject@locked"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      },
      {
        "id": "audit",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "audit"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "inject",
        "trigger": "before_broadcast",
        "reactions": [
          {
            "when": {
              "text": "trigger"
            },
            "do": [
              {
                "call": "send_event",
                "room_id": "$room",
                "channel_id": "ws",
                "content": {
                  "type": "text",
                  "body": "notice"
                },
                "as": "notice"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "trigger"
        }
      },
      "expect": {
        "result": {
          "event": {
            "index": 1,
            "status": "delivered"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "notice"
          },
          "source": {
            "channel_id": "ws"
          }
        },
        {
          "content": {
            "type": "text",
            "body": "trigger"
          }
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "audit": [
          {
            "content": {
              "type": "text",
              "body": "notice"
            }
          },
          {
            "content": {
              "type": "text",
              "body": "trigger"
            }
          }
        ]
      }
    },
    "actions": {
      "notice": [
        {
          "result": {
            "id": "room-1#0",
            "status": "delivered"
          }
        }
      ]
    }
  }
}
