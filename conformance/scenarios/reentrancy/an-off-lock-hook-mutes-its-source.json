{
  "$schema": "../../scenario.schema.json",
  "id": "reentrancy/an-off-lock-hook-mutes-its-source",
  "title": "An off-lock hook that mutes its event's source waits for the lock as any call; the event's source check then reads the mute",
  "rules": [
    "§9.5.1",
    "§7.5 rule 2",
    "§10.1 step 11"
  ],
  "reentrancy": [
    "commit@admitted"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "moderator",
        "trigger": "before_broadcast",
        "needs_lock": false,
        "reactions": [
          {
            "when": {
              "text": "trigger"
            },
            "do": [
              {
                "call": "mute",
                "room_id": "$room",
                "channel_id": "sms",
                "as": "mute"
              }
            ]
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "trigger"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "source_muted"
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "content": {
            "type": "text",
            "body": "trigger"
          },
          "status": "blocked",
          "blocked_by": "source_muted"
        }
      ]
    },
    "actions": {
      "mute": [
        {
          "result": {
            "muted": true
          }
        }
      ]
    }
  }
}
