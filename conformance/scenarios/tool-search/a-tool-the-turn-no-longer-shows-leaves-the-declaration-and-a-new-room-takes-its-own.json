{
  "$schema": "../../scenario.schema.json",
  "id": "tool-search/a-tool-the-turn-no-longer-shows-leaves-the-declaration-and-a-new-room-takes-its-own",
  "title": "A tool the turn no longer shows leaves the room's declaration, and a room whose declaration is not known takes the one its turn shows",
  "rules": [
    "§6.4",
    "§21.1"
  ],
  "requirements": [
    "RK-6.4-396"
  ],
  "notes": "Room 1's first turn, by a member, reveals track_shipment. Its second turn is an observer's, whose role the policy denies track_shipment: the tool leaves the declaration, neither held, reopened nor declared. Room 2's first turn comes after room 1 revealed track_shipment: its declaration is not known, and it takes the one its own turn shows (track_shipment and refund held, nothing reopened), which it keeps on its second turn. Not observed: a skill that closes, a restarted process. Python: channels/_tool_reopen.py.",
  "setup": {
    "channels": [
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "tools": [
          {
            "name": "lookup",
            "description": "Look up.",
            "returns": "ok"
          },
          {
            "name": "track_shipment",
            "description": "Track a shipment.",
            "returns": "ok"
          },
          {
            "name": "refund",
            "description": "Refund an order.",
            "returns": "ok"
          }
        ],
        "model": {
          "deferred_tools": true,
          "rounds": [
            {
              "calls": [
                {
                  "id": "c0",
                  "name": "find_tools",
                  "arguments": {
                    "query": "track shipment",
                    "max_results": 1
                  }
                }
              ]
            },
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "track_shipment"
                }
              ]
            },
            {
              "text": "Done."
            },
            {
              "text": "Hello."
            },
            {
              "text": "Seen."
            },
            {
              "text": "Hello again."
            }
          ]
        },
        "tool_search": true,
        "tool_search_pinned": [
          "lookup"
        ],
        "tool_policy": {
          "role_overrides": {
            "observer": {
              "deny": [
                "track_shipment"
              ]
            }
          }
        }
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ],
        "participants": [
          {
            "id": "dev",
            "channel_id": "ws",
            "role": "member"
          },
          {
            "id": "obs",
            "channel_id": "ws",
            "role": "observer"
          }
        ]
      },
      {
        "id": "room-2",
        "bindings": [
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "go"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "hello"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "ws",
        "sender_id": "obs",
        "content": {
          "type": "text",
          "body": "status?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "room-2",
      "message": {
        "channel_id": "ws",
        "sender_id": "dev",
        "content": {
          "type": "text",
          "body": "hello again"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "models": {
      "agent": [
        {},
        {},
        {},
        {
          "deferred_tools": [
            "track_shipment",
            "refund"
          ],
          "reopened_tools": []
        },
        {
          "deferred_tools": [
            "refund"
          ],
          "reopened_tools": [],
          "tools": {
            "track_shipment": {
              "$absent": true
            }
          }
        },
        {
          "deferred_tools": [
            "track_shipment",
            "refund"
          ],
          "reopened_tools": []
        }
      ]
    }
  }
}
