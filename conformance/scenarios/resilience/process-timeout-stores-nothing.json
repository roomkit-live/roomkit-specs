{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/process-timeout-stores-nothing",
  "title": "A message whose pre-commit phase outlasts process_timeout is refused, nothing of it stored",
  "rules": [
    "§13.6",
    "§8.2"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "slow",
        "trigger": "before_broadcast",
        "timeout_ms": 5000,
        "reactions": [
          {
            "gate": "late"
          }
        ]
      }
    ],
    "kit": {
      "process_timeout_ms": 100
    }
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "Hello"
        }
      },
      "expect": {
        "result": {
          "blocked": true,
          "reason": "process_timeout",
          "event": null
        }
      }
    },
    {
      "open": "late"
    }
  ],
  "expect": {
    "timeline": {
      "room-1": []
    },
    "deliveries": {
      "room-1": {
        "ws": []
      }
    },
    "framework_events": {
      "room-1": [
        {
          "event": "process_timeout",
          "timeout": 0.1
        }
      ]
    }
  }
}
