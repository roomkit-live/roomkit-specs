{
  "$schema": "../../scenario.schema.json",
  "id": "resilience/concurrent-messages-take-their-own-index",
  "title": "Messages processed at once into one room are each committed, at an index of their own",
  "rules": [
    "§8.1",
    "§13.5"
  ],
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "concurrent": [
        {
          "call": "process_inbound",
          "room_id": "room-1",
          "message": {
            "channel_id": "sms",
            "sender_id": "+15551234567",
            "content": {
              "type": "text",
              "body": "one"
            }
          }
        },
        {
          "call": "process_inbound",
          "room_id": "room-1",
          "message": {
            "channel_id": "sms",
            "sender_id": "+15551234567",
            "content": {
              "type": "text",
              "body": "two"
            }
          }
        },
        {
          "call": "process_inbound",
          "room_id": "room-1",
          "message": {
            "channel_id": "sms",
            "sender_id": "+15551234567",
            "content": {
              "type": "text",
              "body": "three"
            }
          }
        }
      ]
    }
  ],
  "expect": {
    "timeline": {
      "room-1": {
        "$unordered": [
          {
            "content": {
              "type": "text",
              "body": "one"
            }
          },
          {
            "content": {
              "type": "text",
              "body": "two"
            }
          },
          {
            "content": {
              "type": "text",
              "body": "three"
            }
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "ws": {
          "$unordered": [
            {
              "content": {
                "type": "text",
                "body": "one"
              }
            },
            {
              "content": {
                "type": "text",
                "body": "two"
              }
            },
            {
              "content": {
                "type": "text",
                "body": "three"
              }
            }
          ]
        }
      }
    }
  }
}
