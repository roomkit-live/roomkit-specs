{
  "$schema": "../../scenario.schema.json",
  "id": "streaming/rows-reach-the-others",
  "title": "A streamed turn: the streaming channel reads the deltas and each row as it is stored, the others receive the rows only, each through BEFORE_BROADCAST once",
  "rules": [
    "§6.1",
    "§12.2 step 13s",
    "§12.2 step 14s",
    "§9.5",
    "§6.4"
  ],
  "notes": "One streaming target per response: the first transport that streams. It is handed every delta, then each row once the store holds it, with its id and its index, the deltas joining to the row's text; it is never delivered a row through deliver(). Every other target receives each row through deliver(), in index order. The final row carries the turn's record when it is stored.",
  "setup": {
    "channels": [
      {
        "id": "web",
        "type": "webhook",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport",
        "streams": true
      },
      {
        "id": "agent",
        "type": "ai",
        "model": {
          "rounds": [
            {
              "deltas": [
                "Let me ",
                "check."
              ],
              "calls": [
                {
                  "id": "call-1",
                  "name": "lookup_order",
                  "arguments": {
                    "order": "42"
                  }
                }
              ],
              "usage": {
                "input_tokens": 100,
                "output_tokens": 10
              }
            },
            {
              "deltas": [
                "Order 42 ",
                "shipped."
              ],
              "usage": {
                "input_tokens": 150,
                "output_tokens": 8
              }
            }
          ]
        },
        "tools": [
          {
            "name": "lookup_order",
            "description": "Find an order by its number",
            "parameters": {
              "type": "object",
              "properties": {
                "order": {
                  "type": "string"
                }
              },
              "required": [
                "order"
              ]
            },
            "returns": "shipped"
          }
        ]
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "web"
          },
          {
            "channel_id": "ws"
          },
          {
            "channel_id": "agent",
            "category": "intelligence"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "gate",
        "trigger": "before_broadcast"
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "web",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "Where is order 42?"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": [
        {
          "index": 0,
          "type": "message",
          "source": {
            "channel_id": "web"
          },
          "content": {
            "body": "Where is order 42?"
          }
        },
        {
          "index": 1,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "responds_to": "room-1#0",
          "content": {
            "type": "text",
            "body": "Let me check."
          },
          "metadata": {
            "loop_end_reason": {
              "$absent": true
            },
            "cancelled": {
              "$absent": true
            }
          }
        },
        {
          "index": 2,
          "type": "tool_call_start",
          "chain_depth": 1,
          "responds_to": "room-1#0",
          "content": {
            "tool_id": "call-1",
            "status": "pending"
          }
        },
        {
          "index": 3,
          "type": "tool_call_end",
          "chain_depth": 1,
          "responds_to": "room-1#0",
          "content": {
            "tool_id": "call-1",
            "status": "completed",
            "result": "shipped"
          }
        },
        {
          "index": 4,
          "type": "message",
          "source": {
            "channel_id": "agent",
            "direction": "outbound"
          },
          "chain_depth": 1,
          "responds_to": "room-1#0",
          "content": {
            "type": "text",
            "body": "Order 42 shipped."
          },
          "metadata": {
            "loop_end_reason": "completed",
            "ai_usage": {
              "input_tokens": 250,
              "output_tokens": 18
            }
          }
        }
      ]
    },
    "streamed": {
      "room-1": {
        "ws": [
          {
            "text": "Let me "
          },
          {
            "text": "check."
          },
          {
            "row": {
              "id": "room-1#1",
              "index": 1,
              "type": "message",
              "content": {
                "body": "Let me check."
              }
            }
          },
          {
            "row": {
              "id": "room-1#2",
              "index": 2,
              "type": "tool_call_start"
            }
          },
          {
            "row": {
              "id": "room-1#3",
              "index": 3,
              "type": "tool_call_end"
            }
          },
          {
            "text": "Order 42 "
          },
          {
            "text": "shipped."
          },
          {
            "row": {
              "id": "room-1#4",
              "index": 4,
              "type": "message",
              "content": {
                "body": "Order 42 shipped."
              }
            }
          }
        ]
      }
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "index": 0
          }
        ],
        "web": [
          {
            "id": "room-1#1",
            "index": 1,
            "type": "message"
          },
          {
            "id": "room-1#2",
            "index": 2,
            "type": "tool_call_start"
          },
          {
            "id": "room-1#3",
            "index": 3,
            "type": "tool_call_end"
          },
          {
            "id": "room-1#4",
            "index": 4,
            "type": "message"
          }
        ]
      }
    },
    "hooks": {
      "gate": [
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "type": "message",
            "content": {
              "body": "Where is order 42?"
            }
          }
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "type": "message",
            "content": {
              "body": "Let me check."
            }
          }
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "type": "tool_call_start"
          }
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "type": "tool_call_end"
          }
        },
        {
          "trigger": "before_broadcast",
          "room_id": "room-1",
          "event": {
            "type": "message",
            "content": {
              "body": "Order 42 shipped."
            }
          }
        }
      ]
    }
  }
}
