{
  "$schema": "../../scenario.schema.json",
  "id": "injection/an-injection-from-a-bound-unregistered-channel-raises",
  "title": "An injection from a channel the room binds but the kit no longer registers raises as an unregistered channel, nothing written",
  "rules": [
    "§10.5",
    "§10.2 An unregistered channel"
  ],
  "notes": "Unregistering a channel leaves its bindings in their rooms (§10.2); the injection names a channel that is not registered, which §10.5 refuses.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "rooms": [
      {
        "id": "room-1",
        "bindings": [
          {
            "channel_id": "sms"
          },
          {
            "channel_id": "ws"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "unregister_channel",
      "channel_id": "ws"
    },
    {
      "call": "send_event",
      "room_id": "room-1",
      "channel_id": "ws",
      "content": {
        "type": "text",
        "body": "from an unregistered channel"
      },
      "expect": {
        "error": "channel_not_registered"
      }
    }
  ],
  "expect": {
    "timeline": {
      "room-1": []
    },
    "deliveries": {
      "room-1": {
        "sms": []
      }
    },
    "bindings": {
      "room-1": {
        "ws": {
          "channel_id": "ws"
        }
      }
    }
  }
}
