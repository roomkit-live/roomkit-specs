{
  "$schema": "../../scenario.schema.json",
  "id": "mcp-host/request-arguments",
  "title": "Omitted and null request parameters send an explicit empty object",
  "rules": [
    "§21.2"
  ],
  "notes": "Public MCPToolProvider over a bounded local HTTP peer; operation results and wire requests are both observed. Native stdio and lifecycle assertions are mapped separately in the lot checklist.",
  "steps": [
    {
      "call": "mcp_session",
      "peer": {
        "replies": [
          {
            "method": "vendor/read",
            "params": {},
            "result": {
              "value": 0
            }
          },
          {
            "method": "vendor/read",
            "params": {},
            "result": {
              "value": 1
            }
          },
          {
            "method": "vendor/read",
            "params": {},
            "result": {
              "value": 2
            }
          },
          {
            "method": "vendor/read",
            "params": {
              "nested": {
                "value": 3
              }
            },
            "result": {
              "value": 3
            }
          }
        ]
      },
      "operations": [
        {
          "method": "connect"
        },
        {
          "method": "request",
          "name": "vendor/read"
        },
        {
          "method": "request",
          "name": "vendor/read",
          "params": null
        },
        {
          "method": "request",
          "name": "vendor/read",
          "params": {}
        },
        {
          "method": "request",
          "name": "vendor/read",
          "params": {
            "nested": {
              "value": 3
            }
          }
        },
        {
          "method": "close"
        }
      ],
      "discover": false,
      "expect": {
        "result": {
          "results": [
            {
              "result": null
            },
            {
              "result": {
                "value": 0
              }
            },
            {
              "result": {
                "value": 1
              }
            },
            {
              "result": {
                "value": 2
              }
            },
            {
              "result": {
                "value": 3
              }
            },
            {
              "result": null
            }
          ],
          "requests": [
            {
              "method": "initialize"
            },
            {
              "method": "vendor/read",
              "params": {}
            },
            {
              "method": "vendor/read",
              "params": {}
            },
            {
              "method": "vendor/read",
              "params": {}
            },
            {
              "method": "vendor/read",
              "params": {
                "nested": {
                  "value": 3
                }
              }
            }
          ],
          "results_json": "[{\"result\":null},{\"result\":{\"value\":0}},{\"result\":{\"value\":1}},{\"result\":{\"value\":2}},{\"result\":{\"value\":3}},{\"result\":null}]",
          "requests_json": "[{\"method\":\"initialize\"},{\"method\":\"vendor/read\",\"params\":{}},{\"method\":\"vendor/read\",\"params\":{}},{\"method\":\"vendor/read\",\"params\":{}},{\"method\":\"vendor/read\",\"params\":{\"nested\":{\"value\":3}}}]"
        }
      }
    }
  ]
}
