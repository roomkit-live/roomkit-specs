{
  "$schema": "../../scenario.schema.json",
  "id": "rooms/a-delivered-message-resumes-a-paused-room",
  "title": "A message the room delivers resumes its PAUSED room, with no hook and no framework event",
  "rules": [
    "§5.1",
    "§10.1 step 12",
    "§26.1"
  ],
  "notes": "The room's inactivity timer is 0 seconds, so it is due again right after the message resumed it; nothing checks it afterwards.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "ws",
        "type": "websocket",
        "category": "transport"
      }
    ],
    "hooks": [
      {
        "name": "paused",
        "trigger": "on_room_paused",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "create_room",
      "room": {
        "id": "room-1",
        "timers": {
          "inactive_after_seconds": 0
        }
      }
    },
    {
      "call": "check_timers",
      "room_id": "room-1",
      "expect": {
        "result": {
          "status": "paused"
        }
      }
    },
    {
      "call": "attach_channel",
      "room_id": "room-1",
      "channel_id": "ws"
    },
    {
      "call": "process_inbound",
      "room_id": "room-1",
      "message": {
        "channel_id": "sms",
        "sender_id": "+15551234567",
        "content": {
          "type": "text",
          "body": "I'm back"
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "event": {
            "status": "delivered"
          }
        }
      }
    }
  ],
  "expect": {
    "rooms": {
      "room-1": {
        "status": "active",
        "paused_at": null
      }
    },
    "hooks": {
      "paused": [
        {
          "trigger": "on_room_paused"
        }
      ]
    },
    "deliveries": {
      "room-1": {
        "ws": [
          {
            "content": {
              "type": "text",
              "body": "I'm back"
            }
          }
        ]
      }
    },
    "framework_events": {
      "room-1": [
        "room_created",
        {
          "event": "room_paused",
          "reason": "timer"
        },
        {
          "event": "room_channel_attached",
          "channel_id": "ws"
        },
        {
          "event": "room_channel_attached",
          "channel_id": "sms"
        },
        {
          "event": "delivery_succeeded",
          "channel_id": "ws"
        },
        {
          "event": "event_processed",
          "event_id": "room-1#0"
        }
      ]
    }
  }
}
