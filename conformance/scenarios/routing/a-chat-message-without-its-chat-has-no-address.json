{
  "$schema": "../../scenario.schema.json",
  "id": "routing/a-chat-message-without-its-chat-has-no-address",
  "title": "On a channel whose replies go to a chat, a message without its chat, or whose chat key holds a value that is no chat, records no one: its room names neither correspondent nor recipient and does not take the author's private chat, and its author stays the sender",
  "rules": [
    "§5.7"
  ],
  "notes": "Python: tests/test_chat_conversations.py::test_a_chat_message_without_its_chat_has_no_address.",
  "setup": {
    "channels": [
      {
        "id": "chat",
        "type": "telegram",
        "category": "transport",
        "recipient_key": "telegram_chat_id",
        "addresses": {
          "conversation_key": "chat_id"
        }
      }
    ]
  },
  "steps": [
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "chat",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "hi"
        },
        "metadata": {
          "chat_id": "7"
        }
      },
      "expect": {
        "result": {
          "event": {
            "room_id": "$private"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "chat",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "lost"
        },
        "metadata": {}
      },
      "expect": {
        "result": {
          "event": {
            "room_id": "$nothing"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "chat",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "true"
        },
        "metadata": {
          "chat_id": true
        }
      },
      "expect": {
        "result": {
          "event": {
            "room_id": "$true"
          }
        }
      }
    },
    {
      "call": "process_inbound",
      "message": {
        "channel_id": "chat",
        "sender_id": "alice",
        "content": {
          "type": "text",
          "body": "blank"
        },
        "metadata": {
          "chat_id": "  "
        }
      },
      "expect": {
        "result": {
          "event": {
            "room_id": "$blank"
          }
        }
      }
    }
  ],
  "expect": {
    "timeline": {
      "$private": [
        {
          "content": {
            "type": "text",
            "body": "hi"
          },
          "source": {
            "participant_id": "alice"
          }
        }
      ],
      "$nothing": [
        {
          "content": {
            "type": "text",
            "body": "lost"
          },
          "source": {
            "participant_id": "alice"
          }
        }
      ],
      "$true": [
        {
          "content": {
            "type": "text",
            "body": "true"
          },
          "source": {
            "participant_id": "alice"
          }
        }
      ],
      "$blank": [
        {
          "content": {
            "type": "text",
            "body": "blank"
          },
          "source": {
            "participant_id": "alice"
          }
        }
      ]
    },
    "bindings": {
      "$private": {
        "chat": {
          "participant_id": "7"
        }
      },
      "$nothing": {
        "chat": {
          "participant_id": null,
          "metadata": {}
        }
      },
      "$true": {
        "chat": {
          "participant_id": null,
          "metadata": {}
        }
      },
      "$blank": {
        "chat": {
          "participant_id": null,
          "metadata": {}
        }
      }
    }
  }
}
