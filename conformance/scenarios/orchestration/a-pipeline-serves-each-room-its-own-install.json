{
  "$schema": "../../scenario.schema.json",
  "id": "orchestration/a-pipeline-serves-each-room-its-own-install",
  "title": "One Pipeline installed in two rooms declares one handoff tool per agent in each; a handoff in one moves that room alone, and the other's agent keeps it",
  "rules": [
    "§19.7.1",
    "§19.7"
  ],
  "notes": "Python: tests/orchestration/test_strategy_pipeline.py TestPipelineInstall::test_double_install_skips_handoff. orchestration/strategies/pipeline.py install, _wire_handoff.",
  "setup": {
    "channels": [
      {
        "id": "sms",
        "type": "sms",
        "category": "transport"
      },
      {
        "id": "a",
        "type": "ai",
        "agent": {
          "role": "A"
        },
        "model": {
          "rounds": [
            {
              "calls": [
                {
                  "id": "c1",
                  "name": "handoff_conversation",
                  "arguments": {
                    "target": "b",
                    "reason": "R.",
                    "summary": "S."
                  }
                }
              ]
            },
            {
              "text": "Moved."
            },
            {
              "text": "Still here."
            }
          ]
        }
      },
      {
        "id": "b",
        "type": "ai",
        "agent": {
          "role": "B"
        },
        "model": {
          "rounds": [
            {
              "text": "B here."
            }
          ]
        }
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      },
      {
        "id": "r2",
        "bindings": [
          {
            "channel_id": "sms"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "seen",
        "trigger": "on_ai_response",
        "execution": "async"
      }
    ],
    "strategies": [
      {
        "id": "team",
        "pipeline": {
          "agents": [
            "a",
            "b"
          ]
        }
      }
    ]
  },
  "steps": [
    {
      "call": "install_strategy",
      "room_id": "r1",
      "strategy": "team"
    },
    {
      "call": "install_strategy",
      "room_id": "r2",
      "strategy": "team"
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "One."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r1",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Two."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    },
    {
      "call": "process_inbound",
      "room_id": "r2",
      "message": {
        "channel_id": "sms",
        "sender_id": "u1",
        "content": {
          "type": "text",
          "body": "Three."
        }
      },
      "expect": {
        "result": {
          "blocked": false,
          "error": null
        }
      }
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "rooms": {
      "r1": {
        "metadata": {
          "_conversation_state": {
            "phase": "b",
            "active_agent_id": "b",
            "handoff_count": 1
          }
        }
      },
      "r2": {
        "metadata": {
          "_conversation_state": {
            "phase": "a",
            "active_agent_id": "a",
            "handoff_count": 0
          }
        }
      }
    },
    "hooks": {
      "seen": [
        {
          "response": {
            "channel_id": "a",
            "declared_tools": {
              "handoff_conversation": {
                "description": "Transfer this conversation to another agent.\nAvailable targets:\n  - b",
                "parameters": {
                  "properties": {
                    "target": {
                      "enum": [
                        "b"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "response": {
            "channel_id": "b",
            "declared_tools": {
              "handoff_conversation": {
                "description": "Transfer this conversation to another agent or specialist. Use when: the user asks to speak with someone else, the user wants to be transferred or go back to a previous agent, the conversation needs expertise you don't have, or your task is complete and the next step requires a different agent. Always provide a clear summary of the conversation so far.",
                "parameters": {
                  "properties": {
                    "target": {
                      "enum": {
                        "$absent": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "response": {
            "channel_id": "a",
            "declared_tools": {
              "handoff_conversation": {
                "description": "Transfer this conversation to another agent.\nAvailable targets:\n  - b",
                "parameters": {
                  "properties": {
                    "target": {
                      "enum": [
                        "b"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
