{
  "$schema": "../../scenario.schema.json",
  "id": "video/by-default-the-bridge-asks-for-keyframes-every-five-seconds",
  "title": "With the default bridge configuration, the periodic keyframe requests come 5 s apart",
  "rules": [
    "§12.8.9"
  ],
  "requirements": [
    "RK-12.8.9-007"
  ],
  "notes": "The first request comes with the first frame the bridge forwards; bob's join added one to alice.",
  "requires_features": [
    "video"
  ],
  "setup": {
    "virtual_clock": true,
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "video.open",
      "room_id": "r1",
      "channel_id": "camera",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": {}
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 1,
      "data": "AQID"
    },
    {
      "call": "video.read",
      "channel_id": "camera",
      "expect": {
        "result": {
          "keyframe_requests": {
            "alice": 2,
            "bob": 1
          }
        }
      }
    },
    {
      "call": "clock.advance",
      "ms": 4900
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 2,
      "data": "BAUG"
    },
    {
      "call": "video.read",
      "channel_id": "camera",
      "expect": {
        "result": {
          "keyframe_requests": {
            "alice": 2,
            "bob": 1
          }
        }
      }
    },
    {
      "call": "clock.advance",
      "ms": 200
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 3,
      "data": "BwgJ"
    },
    {
      "call": "video.read",
      "channel_id": "camera",
      "expect": {
        "result": {
          "keyframe_requests": {
            "alice": 3,
            "bob": 2
          }
        }
      }
    }
  ],
  "expect": {}
}
