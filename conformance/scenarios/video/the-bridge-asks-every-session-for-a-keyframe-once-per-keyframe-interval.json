{
  "$schema": "../../scenario.schema.json",
  "id": "video/the-bridge-asks-every-session-for-a-keyframe-once-per-keyframe-interval",
  "title": "With keyframe_interval_s set, the bridge asks every session of the room for a keyframe once per interval, as it forwards frames",
  "rules": [
    "§12.8.9"
  ],
  "requirements": [
    "RK-12.8.9-010",
    "RK-12.8.9-007"
  ],
  "notes": "A session's first request comes with the first frame the bridge forwards, the interval running from it; a join adds one request to every session already in the room (alice, when bob joins).",
  "requires_features": [
    "video"
  ],
  "setup": {
    "virtual_clock": true,
    "rooms": [
      {
        "id": "r1"
      }
    ]
  },
  "steps": [
    {
      "call": "video.open",
      "room_id": "r1",
      "channel_id": "camera",
      "participants": [
        "alice",
        "bob"
      ],
      "bridge": {
        "keyframe_interval_s": 2
      }
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 1,
      "data": "AQID"
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "bob",
      "sequence": 2,
      "data": "BAUG"
    },
    {
      "call": "video.read",
      "channel_id": "camera",
      "expect": {
        "result": {
          "keyframe_requests": {
            "alice": 2,
            "bob": 1
          }
        }
      }
    },
    {
      "call": "clock.advance",
      "ms": 1500
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 3,
      "data": "BwgJ"
    },
    {
      "call": "video.read",
      "channel_id": "camera",
      "expect": {
        "result": {
          "keyframe_requests": {
            "alice": 2,
            "bob": 1
          }
        }
      }
    },
    {
      "call": "clock.advance",
      "ms": 600
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "alice",
      "sequence": 4,
      "data": "CgsM"
    },
    {
      "call": "video.frame",
      "channel_id": "camera",
      "participant_id": "bob",
      "sequence": 5,
      "data": "DQ4P"
    },
    {
      "call": "video.read",
      "channel_id": "camera",
      "expect": {
        "result": {
          "keyframe_requests": {
            "alice": 3,
            "bob": 2
          }
        }
      }
    }
  ],
  "expect": {}
}
