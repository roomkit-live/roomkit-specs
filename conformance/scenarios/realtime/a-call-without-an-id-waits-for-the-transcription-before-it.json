{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-call-without-an-id-waits-for-the-transcription-before-it",
  "title": "A call without an id is refused only once the transcription the provider gave before it has been through its hooks",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-038"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "result": "found"
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "first",
        "trigger": "on_transcription",
        "execution": "sync",
        "priority": 0,
        "reactions": [
          {
            "gate": "transcribing"
          }
        ]
      },
      {
        "name": "second",
        "trigger": "on_transcription",
        "execution": "sync",
        "priority": 10,
        "reactions": [
          {
            "gate": "transcribed"
          }
        ]
      },
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "sync",
        "reactions": [
          {
            "gate": "reporting"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.transcribe",
      "channel_id": "rt",
      "text": "Look it up",
      "role": "user"
    },
    {
      "wait_for": "transcribing"
    },
    {
      "call": "realtime.tool_call",
      "channel_id": "rt",
      "call_id": "",
      "name": "lookup"
    },
    {
      "open": "transcribing"
    },
    {
      "wait_for": "transcribed"
    },
    {
      "open": "transcribed"
    },
    {
      "wait_for": "reporting",
      "after": "transcribed"
    },
    {
      "open": "reporting"
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "name": "lookup",
            "refused": true
          }
        }
      ]
    }
  }
}
