{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/a-pipeline-vad-that-endpoints-drives-the-speech-edges",
  "title": "On a provider that takes turns, the pipeline VAD drives turn-taking: the server VAD is off, and only the pipeline's speech start fires ON_SPEECH_START",
  "rules": [
    "§12.4"
  ],
  "requirements": [
    "RK-12.4-122"
  ],
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "pipeline": {
            "vad": [
              {
                "type": "speech_start"
              }
            ]
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ],
    "hooks": [
      {
        "name": "starts",
        "trigger": "on_speech_start",
        "execution": "async"
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "connects": [
            {
              "server_vad": false
            }
          ]
        }
      }
    },
    {
      "call": "realtime.speech",
      "channel_id": "rt",
      "edge": "start"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.audio",
      "channel_id": "rt",
      "source": "transport",
      "frames": [
        "ABAAEAAQABA="
      ]
    },
    {
      "idle": true
    }
  ],
  "expect": {
    "hooks": {
      "starts": [
        {
          "room_id": "r1"
        }
      ]
    }
  }
}
