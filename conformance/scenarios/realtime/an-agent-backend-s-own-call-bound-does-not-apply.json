{
  "$schema": "../../scenario.schema.json",
  "id": "realtime/an-agent-backend-s-own-call-bound-does-not-apply",
  "title": "An agent backend's own bound on its calls does not apply on top of the channel's gate",
  "rules": [
    "§12.4.1",
    "§19",
    "§6.4"
  ],
  "requirements": [
    "RK-12.4.1-072"
  ],
  "notes": "The agent's own bound is 1 ms; the call is held at a gate until a later step opens it.",
  "requires_features": [
    "realtime"
  ],
  "setup": {
    "channels": [
      {
        "id": "rt",
        "type": "realtime_voice",
        "realtime": {
          "tools": {
            "lookup": {
              "gate": "lookup-held",
              "result": "found"
            },
            "weather": {
              "result": "sunny"
            }
          },
          "reasoning": {
            "agent": {
              "id": "reasoner",
              "type": "ai",
              "model": {
                "rounds": [
                  {
                    "calls": [
                      {
                        "id": "b1",
                        "name": "lookup"
                      }
                    ]
                  },
                  {
                    "text": "Found it."
                  }
                ]
              },
              "tool_timeout_ms": 1
            }
          }
        }
      },
      {
        "id": "src",
        "type": "websocket"
      }
    ],
    "hooks": [
      {
        "name": "reports",
        "trigger": "on_tool_call",
        "execution": "async"
      }
    ],
    "rooms": [
      {
        "id": "r1",
        "bindings": [
          {
            "channel_id": "src"
          },
          {
            "channel_id": "rt"
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "call": "realtime.start",
      "channel_id": "rt",
      "room_id": "r1",
      "participant_id": "alice"
    },
    {
      "call": "realtime.delegate",
      "channel_id": "rt",
      "delegation_id": "d1",
      "target": "integrator"
    },
    {
      "wait_for": "lookup-held"
    },
    {
      "call": "realtime.read",
      "channel_id": "rt"
    },
    {
      "open": "lookup-held"
    },
    {
      "idle": true
    },
    {
      "call": "realtime.read",
      "channel_id": "rt",
      "expect": {
        "result": {
          "handlers": [
            {
              "name": "lookup",
              "outcome": "returned"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "hooks": {
      "reports": [
        {
          "tool_call": {
            "tool_call_id": "d1:b1",
            "name": "lookup",
            "result": "found",
            "is_error": false
          }
        }
      ]
    }
  }
}
